.env
config/voices.local.json
.claude/settings.local.json

# the character pack is licensed for use, not for redistribution: never commit it
packs/*
!packs/README.md

# generated media
output/clips/*/render/
output/clips/*/final/
output/clips/*/review/
output/clips/*/audio/*.wav
