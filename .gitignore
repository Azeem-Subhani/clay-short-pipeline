library/materials/ambientcg/
library/_models/
*.blend1
*.preview.png

# tools
node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# update archives are never committed
pipeline-patch.zip

# raw inputs that are too big or not ours to redistribute
Character_Rebuild_Video_Pipeline.zip
reference-videos-*/
output/voice-tests/
output/clips/*/*.log
output/clips/*/preview/
output/_staging/

