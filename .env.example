# Copy to .env (python tools/clip.py setup does this) and fill in. .env is git-ignored.

# ElevenLabs: narration, music, sound effects. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Only if Blender 5.3 is not on PATH and not in the default install folder:
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.3\blender.exe
# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender

# Only if FFmpeg is not on PATH:
# FFMPEG_BIN=
# FFPROBE_BIN=

# Only if Remotion should use a browser you already have instead of downloading its own:
# REMOTION_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe

# Only if the BlenderKit add-on keeps its downloads somewhere else than ~/blenderkit_data:
# BLENDERKIT_DATA_DIR=
